---
import Base from "../../layouts/Base.astro";
import PersonCard from "../../components/PersonCard.astro";
import { getCollection, getEntry } from "astro:content";
import { intros, hasProfile, years, ALUMNI_ROLE_LABEL } from "../../lib/site";

const people = await getCollection("people");
const familyName = (name: string) => name.replace(/\s*\(.*?\)/g, "").trim().split(/\s+/).pop() ?? name;
const current = people.filter((p) => p.data.status === "current");
const groups = intros.people.groups
  .map((g: any) => ({
    ...g,
    // Students of all levels are listed together, ordered by family name.
    members: current
      .filter((p) => g.roles.includes(p.data.role))
      .sort((a, b) => familyName(a.data.name).localeCompare(familyName(b.data.name))),
  }))
  .filter((g: any) => g.members.length > 0);

const ALUMNI_ORDER = ["postdoc", "phd", "adjunct", "visiting", "ms", "undergrad", "intern"];
const alumni = people
  .filter((p) => p.data.status === "alumni")
  .sort((a, b) =>
    ALUMNI_ORDER.indexOf(a.data.role) - ALUMNI_ORDER.indexOf(b.data.role) ||
    String(b.data.end ?? "").localeCompare(String(a.data.end ?? "")),
  );
const honors = await Promise.all(
  intros.people.honors.map(async (h: any) => ({ ...h, person: await getEntry("people", h.person) })),
);
---
<Base title={intros.people.title} description={intros.people.lead}>
  <header class="page-head">
    <div class="wrap">
      <h1>{intros.people.title}</h1>
      <p class="lede">{intros.people.lead}</p>
    </div>
  </header>

  {groups.map((g: any, i: number) => (
    <section class:list={["section", { "section--concrete": i % 2 === 1 }]} style="padding-block: 48px" aria-labelledby={`g-${g.id}`}>
      <div class="wrap">
        <h2 id={`g-${g.id}`}>{g.label}</h2>
        <div class="people">{g.members.map((p: any) => <PersonCard person={p} />)}</div>
      </div>
    </section>
  ))}

  <section class="section" id="alumni" aria-labelledby="alumni-title">
    <div class="wrap">
      <h2 id="alumni-title">Alumni</h2>
      <p>{intros.people.alumni_lead}</p>
      <table class="alumni-table">
        <thead><tr><th scope="col">Name</th><th scope="col">In the lab</th><th scope="col">Now</th></tr></thead>
        <tbody>
          {alumni.map((p) => (
            <tr>
              <td>{hasProfile(p) ? <a href={`/people/${p.id}`}>{p.data.name}</a> : p.data.name}</td>
              <td>{ALUMNI_ROLE_LABEL[p.data.role]}, {years(p.data.start, p.data.end)}</td>
              <td>{p.data.current_url ? <a href={p.data.current_url}>{p.data.current_position}</a> : (p.data.current_position ?? p.data.note ?? "")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="honors-title">
    <div class="wrap">
      <h2 id="honors-title">{intros.people.honors_heading}</h2>
      <ul class="news-list">
        {honors.map((h: any) => (
          <li class="news-item">
            <span class="news-date">{h.year}</span>
            <div><p class="news-title">{h.name}</p><p class="muted">{h.person?.data.name}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
