---
import PhotoStrip from "../../components/PhotoStrip.astro";
import Base from "../../layouts/Base.astro";
import PersonCard from "../../components/PersonCard.astro";
import { getCollection, getEntry } from "astro:content";
import { intros, hasProfile, years, initials, publicFileExists, ALUMNI_ROLE_LABEL } from "../../lib/site";

const people = await getCollection("people");
const familyName = (name: string) => name.replace(/\s*\(.*?\)/g, "").trim().split(/\s+/).pop() ?? name;
const current = people.filter((p) => p.data.status === "current");
const groups = intros.people.groups
  .map((g: any) => ({
    ...g,
    // Students of all levels share one section: ordered by level (g.roles order),
    // then manual order, then start year, then family name.
    members: current
      .filter((p) => g.roles.includes(p.data.role))
      .sort((a, b) =>
        g.roles.indexOf(a.data.role) - g.roles.indexOf(b.data.role) ||
        (a.data.order ?? 0) - (b.data.order ?? 0) ||
        String(a.data.start ?? "9999").localeCompare(String(b.data.start ?? "9999")) ||
        familyName(a.data.name).localeCompare(familyName(b.data.name)),
      ),
  }))
  .filter((g: any) => g.members.length > 0);

const ALUMNI_ORDER = ["postdoc", "phd", "adjunct", "visiting", "ms", "undergrad", "intern"];
const alumni = people
  .filter((p) => p.data.status === "alumni")
  .sort((a, b) =>
    ALUMNI_ORDER.indexOf(a.data.role) - ALUMNI_ORDER.indexOf(b.data.role) ||
    // Within each role: graduates first (members without a profile, e.g. transfers, go last),
    // then manual order, then earliest graduation (end), then earliest start.
    Number(a.data.profile === false) - Number(b.data.profile === false) ||
    (a.data.order ?? 0) - (b.data.order ?? 0) ||
    String(a.data.end ?? "").localeCompare(String(b.data.end ?? "")) ||
    String(a.data.start ?? "").localeCompare(String(b.data.start ?? "")),
  );
// Faculty alumni, most recent first.
const faculty = alumni
  .filter((p) => p.data.faculty)
  .sort((a, b) => String(b.data.end ?? "").localeCompare(String(a.data.end ?? "")));
const honors = await Promise.all(
  intros.people.honors.map(async (h: any) => ({ ...h, person: await getEntry("people", h.person) })),
);
---
<Base title={intros.people.title} description={intros.people.lead}>
  <header class="page-head">
    <div class="wrap">
      <h1>{intros.people.title}</h1>
      <p class="lede">{intros.people.lead}</p>
    </div>
  </header>

  <div class="wrap" style="margin-bottom: 40px">
    <PhotoStrip wide columns={1} photos={[{ src: "/media/photos/ite-visit-group-wide.jpg", alt: "A group of lab members and visitors standing on either side of the lab's automated vehicle in a parking lot", caption: "Lab members and visitors from the Penn State ITE student chapter with our automated vehicle, February 2024." }]} />
  </div>

  {groups.map((g: any, i: number) => (
    <section class:list={["section", { "section--concrete": i % 2 === 1 }]} style="padding-block: 48px" aria-labelledby={`g-${g.id}`}>
      <div class="wrap people-group">
        <h2 id={`g-${g.id}`}>{g.label}</h2>
        <div class="people">{g.members.map((p: any) => <PersonCard person={p} />)}</div>
      </div>
    </section>
  ))}

  {faculty.length > 0 && (
    <section class="section section--navy" aria-labelledby="faculty-title">
      <div class="wrap">
        <h2 id="faculty-title">{intros.people.faculty_heading}</h2>
        <p>{intros.people.faculty_lead}</p>
        <ul class="faculty-alumni">
          {faculty.map((p) => (
            <li>
              <span class="faculty-photo">
                {publicFileExists(p.data.photo) ? <img src={p.data.photo} alt="" /> : <span aria-hidden="true">{initials(p.data.name)}</span>}
              </span>
              <div>
                <p class="faculty-name">{hasProfile(p) ? <a href={`/people/${p.id}`}>{p.data.name}</a> : p.data.name}</p>
                <p class="faculty-now">{p.data.current_url ? <a href={p.data.current_url}>{p.data.current_position}</a> : p.data.current_position}</p>
                <p class="faculty-was">{ALUMNI_ROLE_LABEL[p.data.role]}, {years(p.data.start, p.data.end)}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" id="alumni" aria-labelledby="alumni-title">
    <div class="wrap">
      <h2 id="alumni-title">Alumni</h2>
      <p>{intros.people.alumni_lead}</p>
      <table class="alumni-table">
        <thead><tr><th scope="col">Name</th><th scope="col">In the lab</th><th scope="col">Now</th></tr></thead>
        <tbody>
          {alumni.map((p) => (
            <tr>
              <td>{hasProfile(p) ? <a href={`/people/${p.id}`}>{p.data.name}</a> : p.data.name}</td>
              <td>{ALUMNI_ROLE_LABEL[p.data.role]}, {years(p.data.start, p.data.end)}</td>
              <td>
                {p.data.faculty && <span class="tag-faculty">Faculty</span>}
                {p.data.current_url ? <a href={p.data.current_url}>{p.data.current_position}</a> : (p.data.current_position ?? p.data.note ?? "")}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="honors-title">
    <div class="wrap">
      <h2 id="honors-title">{intros.people.honors_heading}</h2>
      <ul class="news-list">
        {honors.map((h: any) => (
          <li class="news-item">
            <span class="news-date">{h.year}</span>
            <div><p class="news-title">{h.name}</p><p class="muted">{h.person?.data.name}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
