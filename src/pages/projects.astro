---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { intros, years } from "../lib/site";

const projects = (await getCollection("projects")).sort(
  (a, b) => (b.data.start ?? 0) - (a.data.start ?? 0) || a.data.title.localeCompare(b.data.title),
);
const groups = [
  { label: "At Penn State", items: projects.filter((p) => p.data.institution === "psu") },
  { label: "At Missouri S&T", items: projects.filter((p) => p.data.institution === "mst") },
  { label: "At Metropia", items: projects.filter((p) => p.data.institution === "metropia") },
];
---
<Base title={intros.projects.title} description={intros.projects.lead}>
  <header class="page-head">
    <div class="wrap">
      <h1>{intros.projects.title}</h1>
      <p class="lede">{intros.projects.lead}</p>
    </div>
  </header>

  <section class="section section--concrete" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 id="tools-title">{intros.projects.tools_heading}</h2>
      <div class="tools">
        {intros.projects.tools.map((t: any) => (
          <div class="tool"><a href={t.url}>{t.name}</a><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section" style="padding-bottom: 24px">
      <div class="wrap">
        <h2>{g.label}</h2>
        <ul class="projects">
          {g.items.map((p) => (
            <li class="project">
              <div>
                <p class="project-title">{p.data.title}</p>
                <p class="project-sponsor">
                  {p.data.sponsors.join(", ")}
                  {p.data.kind === "internal" && " (internal)"}
                </p>
                {(p.data.tool || p.data.dataset) && (
                  <p class="news-links">
                    {p.data.tool && <a href={p.data.tool}>Project site</a>}
                    {p.data.dataset && <a href={p.data.dataset}>Dataset</a>}
                  </p>
                )}
              </div>
              <p class="project-side">{years(p.data.start, p.data.end)}<br />{p.data.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
