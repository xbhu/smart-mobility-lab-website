---
import Base from "../../layouts/Base.astro";
import Video from "../../components/Video.astro";
import PaperItem from "../../components/PaperItem.astro";
import PhotoStrip from "../../components/PhotoStrip.astro";
import { getCollection, getEntry, getEntries, render } from "astro:content";
import { years } from "../../lib/site";
import { thrustProjects } from "../../lib/thrust";

export async function getStaticPaths() {
  const thrusts = await getCollection("thrusts");
  return thrusts.map((t) => ({ params: { thrust: t.id }, props: { thrust: t } }));
}

const { thrust } = Astro.props;
const t = thrust.data;
const { Content } = await render(thrust);

const featured = await getEntries(t.featured_papers);
const subtopics = await Promise.all(
  t.subtopics.map(async (s) => ({ ...s, entries: await getEntries(s.papers) })),
);
const videos = await getEntries(t.videos);
const allPapers = (await getCollection("papers"))
  .filter((p) => p.data.thrusts.includes(thrust.id as any))
  .sort((a, b) => b.data.year - a.data.year);
const recent = allPapers.slice(0, 10);
const projects = await thrustProjects(thrust);
const isUrl = (s: string | null) => Boolean(s);
const INSTITUTION: Record<string, string> = { mst: "at Missouri S&T", metropia: "at Metropia" };
const hasResources = Boolean(t.resources && t.resources.length > 0);
// Alternate white and concrete backgrounds over the sections that are actually shown.
const shown = ["content", "sub", videos.length > 0 ? "videos" : null, "more"].filter(Boolean);
const bg = (key: string) => (shown.indexOf(key) % 2 === 1 ? "section section--concrete" : "section");
---
<Base title={t.name} description={t.tagline} image={t.hero.image ?? undefined}>
  <header class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/research">Research</a></p>
      <h1>{t.name}</h1>
      <p class="lede">{t.tagline}</p>
    </div>
  </header>

  {isUrl(t.hero.image) && (
    <div class="thrust-hero"><img src={t.hero.image!} alt={t.hero.image_alt ?? ""} /></div>
  )}

  <section class={bg("content")}>
    <div class="wrap prose"><Content /></div>
    {t.gallery && t.gallery.length > 0 && <div class="wrap"><PhotoStrip photos={t.gallery} /></div>}
  </section>

  <section class={bg("sub")} aria-labelledby="sub-title">
    <div class="wrap">
      <h2 id="sub-title">What we work on</h2>
      <div class="subtopics">
        {subtopics.map((s) => (
          <div class="subtopic">
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            {s.entries.length > 0 && (
              <ul>{s.entries.slice(0, 3).map((p) => <li><em>{p.data.title}</em> ({p.data.venue_short ?? p.data.venue}, {p.data.year})</li>)}</ul>
            )}
            {s.links && s.links.length > 0 && (
              <ul>{s.links.map((l) => <li><a href={l.url}>{l.label}</a>{l.note && <> ({l.note})</>}</li>)}</ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  {videos.length > 0 && (
    <section class={bg("videos")} aria-labelledby="vid-title">
      <div class="wrap">
        <h2 id="vid-title">Videos</h2>
        <div class="video-grid">{videos.map((v) => <div><Video video={v} /></div>)}</div>
      </div>
    </section>
  )}

  <section class={bg("more")} aria-label="Representative work, sponsored projects, and publications">
    <div class="wrap">
      <div class="accordion">
        <details class="collapsible">
          <summary>
            <span class="collapsible-title" id="feat-title">Representative work</span>
            <span class="collapsible-sub">{featured.length} papers that best represent this thrust</span>
          </summary>
          <ul class="pubs">{featured.map((p) => <PaperItem paper={p} showSummary />)}</ul>
        </details>

        {projects.length > 0 && (
          <details class="collapsible">
            <summary>
              <span class="collapsible-title" id="proj-title">Sponsored projects</span>
              <span class="collapsible-sub">{projects.length} externally funded {projects.length === 1 ? "project" : "projects"}</span>
            </summary>
            <ul class="projects">
              {projects.map((p) => (
                <li class="project">
                  <div>
                    <p class="project-title">{p.data.title}</p>
                    <p class="project-sponsor">{p.data.sponsors.join(", ")}</p>
                  </div>
                  <p class="project-side">{years(p.data.start, p.data.end)}<br />{p.data.role}{INSTITUTION[p.data.institution] && <><br />{INSTITUTION[p.data.institution]}</>}</p>
                </li>
              ))}
            </ul>
            <p><a href="/projects">All projects</a></p>
          </details>
        )}

        <details class="collapsible">
          <summary>
            <span class="collapsible-title" id="pubs-title">Recent publications</span>
            <span class="collapsible-sub">{recent.length < allPapers.length ? `The ${recent.length} most recent of ${allPapers.length} selected papers in this thrust` : `All ${allPapers.length} selected papers in this thrust`}</span>
          </summary>
          <ul class="pubs">{recent.map((p) => <PaperItem paper={p} />)}</ul>
          <p><a href={`/publications?thrust=${thrust.id}`}>All {allPapers.length} papers in this thrust</a></p>
        </details>
      </div>

      {hasResources && (
        <>
          <h2 style="margin-top: 56px">Data and resources</h2>
          <div class="tools">{t.resources!.map((r) => <div class="tool"><a href={r.url}>{r.label}</a></div>)}</div>
        </>
      )}
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap">
      <h2>Work with us</h2>
      <p>{t.collaborate}</p>
      <a class="btn btn--lane" href="mailto:xbhu@psu.edu">Email Dr. Hu</a>
    </div>
  </section>
</Base>
