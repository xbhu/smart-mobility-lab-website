---
import Base from "../../layouts/Base.astro";
import ThrustCard from "../../components/ThrustCard.astro";
import { getCollection } from "astro:content";
import { intros } from "../../lib/site";
import { thrustProjects } from "../../lib/thrust";

const thrusts = (await getCollection("thrusts")).sort((a, b) => a.data.order - b.data.order);
const papers = await getCollection("papers");
// Project counts match the lists on each thrust page.
const projectCounts = Object.fromEntries(await Promise.all(thrusts.map(async (t) => [t.id, (await thrustProjects(t)).length])));
const count = (id: string) => ({
  papers: papers.filter((p) => p.data.thrusts.includes(id as any)).length,
  projects: projectCounts[id] as number,
});
const facilities = (await getCollection("facilities")).sort(
  (a, b) => ["autonomous-vehicle", "test-track", "driving-simulator"].indexOf(a.id) - ["autonomous-vehicle", "test-track", "driving-simulator"].indexOf(b.id),
);
const f = intros.research.facilities;
// One photo per facility for the showcase; set in intros.yaml.
const tiles = facilities.map((x) => ({ ...x, tile: f.tiles[x.id] }));
---
<Base title={intros.research.title} description={intros.research.lead}>
  <header class="page-head">
    <div class="wrap">
      <h1>{intros.research.title}</h1>
      <p class="lede">{intros.research.lead}</p>
    </div>
  </header>

  <section class="section" aria-label="Research thrusts">
    <div class="wrap">
      <div class="thrust-cards">
        {thrusts.map((t, i) => <ThrustCard thrust={t} index={i} papers={count(t.id).papers} projects={count(t.id).projects} />)}
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="fac-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="fac-title">{f.heading}</h2>
          <p>{f.lead}</p>
        </div>
        <a class="btn btn--lane" href="/facilities">See our facilities</a>
      </div>
      <div class="fac-mosaic">
        {tiles.map((x, i) => (
          <a class:list={["fac-tile", { "fac-tile--big": i === 0 }]} href={`/facilities#${x.id}`}>
            <img src={x.tile.src} alt={x.tile.alt} loading="lazy" />
            <span class="fac-tile-text">
              <span class="fac-tile-name">{x.data.name}</span>
              <span class="fac-tile-sub">{x.data.tagline}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
